{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/check-public.sh\"",
            "timeout": 60,
            "statusMessage": "Checking public/ syntax + paths"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python -m http.server:*)",
      "Bash(python3 -m http.server:*)",
      "Bash(python3 -m json.tool:*)",
      "Bash(python3 -m venv:*)",
      "Bash(python3 -c:*)",
      "Bash(python3 -m ensurepip:*)",
      "Bash(python:*)",
