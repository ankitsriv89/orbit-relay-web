      "Bash(jq:*)",
      "Bash(source:*)",
      "Bash(export:*)",
      "Bash(xargs:*)",
      "Bash(tr:*)",
      "Bash(cut:*)",
      "Bash(wc -c:*)",
      "Bash(wc -l:*)",
      "Bash(node --version:*)",
