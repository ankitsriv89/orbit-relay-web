# Cloudflare Pages reads this ONLY at the root of public/. Do not move it.
#
# Ported from the pre-split playground repo, dropping every rule for a game that
# does not live here. Nothing in public/ is content-hashed — there is no build
# step to hash with — so `immutable` is unsafe for anything we ship and edit.
# Long TTLs below are reserved for genuinely frozen third-party bytes.

# TLE baselines refresh on a Celestrak cadence; six hours is well inside it.
/data/tle/*
  Cache-Control: public, max-age=21600

# Vendored third-party bytes. These are genuinely frozen — a satellite.js bump
# lands under a new upload, not an edit — so a long TTL is safe here. The
# engine's own source is revalidated with the app routes below.
/orbit-engine/vendor/*
  Cache-Control: public, max-age=604800

# App routes — HTML + hand-edited ES modules, filenames NOT content-hashed.
#
# `no-cache` here does not mean "do not cache". It means "cache it, but
# revalidate before every reuse". Combined with the strong ETag Pages already
# sends, a reload costs one conditional request per file and returns 304 with a
# zero-byte body when nothing changed — so the bytes are still served from disk,
# but a user can never be pinned to a stale build.
#
# This replaces a flat `max-age=86400`, under which a shipped fix could not
# reach an already-cached browser for a day. That is not hypothetical: the
# `Invalid URL` bug in spacetrack/shared/api.js survived its own fix this way,
# and repeated hard reloads did not clear it.
#
# `stale-while-revalidate` is deliberately NOT used for these. It serves the
# stale copy to the visitor who triggered the revalidation and only refreshes
# for the *next* one — which for a broken deploy means the person hitting the
# bug still sees the bug. It stays on /css/* and /js/* below, where a
# one-load-late stylesheet is cosmetic rather than a dead page.
#
# Module imports (`import … from './shared/api.js'`) are resolved by the browser
# and never pass through the HTML, so a `?v=` query on a <script src> would not
# version them. Revalidation is what covers the whole graph.
/orbit/*
  Cache-Control: public, no-cache, must-revalidate

/spacetrack/*
  Cache-Control: public, no-cache, must-revalidate

/starlink/*
  Cache-Control: public, no-cache, must-revalidate

/about/*
  Cache-Control: public, no-cache, must-revalidate

/wiki/*
  Cache-Control: public, no-cache, must-revalidate

/orbit-engine/*
  Cache-Control: public, no-cache, must-revalidate

# Landing-page assets, un-hashed like everything else here.
#
# CSS keeps stale-while-revalidate: a stylesheet that is one load out of date
# renders slightly differently, it does not break the page.
/css/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# JS is executable and revalidates like the app routes above — landing.js and
# hero-scene.js can fail the same way a stale catalog.js can.
/js/*
  Cache-Control: public, no-cache, must-revalidate

/icon.svg
  Cache-Control: public, max-age=86400

/icons/*
  Cache-Control: public, max-age=86400

# Admin pages — no caching, no indexing.
/admin/*
  Cache-Control: no-store, no-cache, must-revalidate
  X-Robots-Tag: noindex, nofollow, noarchive
  Referrer-Policy: no-referrer
/api/admin/*
  Cache-Control: no-store, no-cache, must-revalidate
  X-Robots-Tag: noindex, nofollow

# Security headers. No CSP here on purpose: these pages load Cesium from a CDN
# and run two Web Workers, so a policy written blind would break the globe.
# Add one deliberately, with the CDN and worker-src enumerated, and test it.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(self), microphone=(), camera=(), interest-cohort=()
